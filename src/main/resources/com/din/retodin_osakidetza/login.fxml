<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="368.0" prefWidth="389.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.din.retodin_osakidetza.Controller.LoginController">
   <children>
      <Label text="Iniciar sesión" />
      <Label text="Usuario" />
      <TextField fx:id="usuario" />
      <Label text="Contraseña" />
      <PasswordField fx:id="contrasena" />
      <Button fx:id="primaryButton" onAction="#login" text="Iniciar sesión" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>