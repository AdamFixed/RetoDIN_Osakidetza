<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane id="AnchorPane" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.din.retodin_osakidetza.Controller.InforamcionController">
   <top>
      <Label fx:id="bienvenido" text="BIENVENIDO : " BorderPane.alignment="CENTER">
         <font>
            <Font name="Segoe UI Bold" size="24.0" />
         </font>
         <BorderPane.margin>
            <Insets top="20.0" bottom="10.0" />
         </BorderPane.margin>
      </Label>
   </top>

   <center>
      <HBox spacing="20.0">
         <padding>
            <Insets left="20.0" right="20.0" />
         </padding>
         <children>
            <VBox fx:id="medicos" HBox.hgrow="ALWAYS" minWidth="150.0" spacing="5.0">
               <children>
                  <Label text="Medicos:" textFill="#5b5b5b">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <ListView fx:id="listaMedicos" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>

            <VBox fx:id="pacientes" HBox.hgrow="ALWAYS" minWidth="150.0" spacing="5.0">
               <children>
                  <Label text="Pacientes:" textFill="#5b5b5b">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <ListView fx:id="listaPacientes" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>

            <VBox fx:id="editar" HBox.hgrow="ALWAYS" minWidth="200.0" spacing="10.0">
               <children>
                  <Label fx:id="lblDetalle" text="Detalles del seleccionado:">
                     <font>
                        <Font name="System Bold" size="15.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblNombre" text="Nombre: " />
                  <TextField fx:id="tfNombre" maxWidth="Infinity" />
                  <Label fx:id="lblApellidos" text="Apellidos " />
                  <TextField fx:id="tfApellido" maxWidth="Infinity" />
                  <Label fx:id="lblTelefono" text="Teléfono: " />
                  <TextField fx:id="tfTelefono" maxWidth="Infinity" />
                  <Label fx:id="lblDato1" text="Label" />
                  <TextField fx:id="tfDato1" maxWidth="Infinity" />
                  <Label fx:id="lblDato2" text="Label" />
                  <TextField fx:id="tfDato2" maxWidth="Infinity" />
                  <Button fx:id="guardar" mnemonicParsing="false" onAction="#guardar" text="Guardar cambios" maxWidth="Infinity" />
               </children>
            </VBox>
         </children>
      </HBox>
   </center>

   <bottom>
      <Button fx:id="logOut" mnemonicParsing="false" onAction="#logOut" text="Cerrar Sesion" BorderPane.alignment="CENTER_RIGHT">
         <BorderPane.margin>
            <Insets top="10.0" right="20.0" bottom="20.0" />
         </BorderPane.margin>
      </Button>
   </bottom>
</BorderPane>